# Database
DATABASE_URL=postgresql://admin:localpass123@localhost:5432/vehicle_classification

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Model Configuration
# YOLO_MODEL options:
#   - yolo12n_lvis: Custom-trained LVIS model (17 vehicle classes) - RECOMMENDED ⭐
#   - yolo11n: COCO pretrained (generic car/truck/bus)
#   - yolo12n: COCO pretrained (generic car/truck/bus)
YOLO_MODEL=yolo12n_lvis
YOLO_CONFIDENCE=0.25

# CLIP Configuration (for vehicle type and color classification)
# Set ENABLE_CLIP=false for low-memory environments (< 1GB RAM)
ENABLE_CLIP=true
CLIP_MODEL=openai/clip-vit-base-patch32
# Alternative: openai/clip-vit-large-patch14 (more accurate, uses more memory)

# Storage
UPLOAD_DIR=./uploads

# Optional
MAX_UPLOAD_SIZE=10485760

